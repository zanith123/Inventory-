# ============================================================================
# Inventory Management System - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# ============================================================================

# Application Settings
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com

# ----------------------------------------------------------------------------
# Option A: Standard Database Credentials (XAMPP / Laragon / cPanel / VPS)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventory_db
DB_USER=root
DB_PASS=

# ----------------------------------------------------------------------------
# Option B: Cloud Database Connection String (Railway / Render / Heroku)
# If DATABASE_URL is set, it overrides the individual DB_* settings above.
# Example: mysql://user:password@host.railway.app:3306/railway
# ----------------------------------------------------------------------------
# DATABASE_URL=mysql://user:password@host:3306/inventory_db
